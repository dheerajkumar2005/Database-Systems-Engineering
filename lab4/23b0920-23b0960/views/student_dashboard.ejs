<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Student Dashboard</title>
</head>

<body>
    <h1>Student Dashboard</h1>
    <a href="/logout">Logout</a>

    <hr>

    <h1>Welcome, <%= full_name %></h1>
    <p><strong>Current Total Credits:</strong> <%= total_credits %> / 24</p>
    
    <% if (error_msg) { %>
        <p style="color: red;"><%= error_msg %></p>
    <% } %>

    <% if (success_msg) { %>
        <p style="color: green;"><%= success_msg %></p>
    <% } %>

    <!-- TODO: Display Registered Courses -->
    <!-- Show: Course ID, Name, Credits, Slot -->
    <!-- Action: Drop Button -->
    <h2>My Registered Courses</h2>
    <table border="1">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Credits</th>
                <th>Slot</th>
                <th> Capacity</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <% registered_courses.forEach(course => { %>
                <tr>
                    <td><%= course.course_id %></td>
                    <td><%= course.course_name %></td>
                    <td><%= course.credits %></td>
                    <td><%= course.slot %></td>
                    <td><%= course.capacity %></td>
                    <td>
                        <form action="/student/drop" method="POST">
                            <input type="hidden" name="course_id" value="<%= course.course_id %>">
                            <button type="submit">Drop</button>
                        </form>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>


    <!-- TODO: Display Available Courses -->
    <!-- Show: Course ID, Name, Credits, Slot, Capacity -->
    <!-- Action: Register Button -->
    <h2>Available Courses</h2>
    <table border="1">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Credits</th>
            <th>Slot</th>
            <th> Capacity</th>
            <th>Action</th>
        </tr>
    </thead>
        <tbody>
            <% available_courses.forEach(course => { %>
                <tr>
                    <td><%= course.course_id %></td>
                    <td><%= course.course_name %></td>
                    <td><%= course.credits %></td>
                    <td><%= course.slot %></td>
                    <td><%= course.capacity %></td>
                    <td>
                        <form action="/student/register" method="POST">
                            <input type="hidden" name="course_id" value="<%= course.course_id %>">
                            <button type="submit">Register</button>
                        </form>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</body>

</html>